# Optional Google Maps Platform API key with Places API (New) enabled
GOOGLE_MAPS_API_KEY=replace_with_a_rotated_key

# Booking.com Demand API credentials (keep private; never commit real values)
BOOKING_API_TOKEN=replace_with_booking_token
BOOKING_AFFILIATE_ID=replace_with_affiliate_id
# Use sandbox for testing or production for live affiliate inventory
BOOKING_API_MODE=sandbox
BOOKING_API_VERSION=3.2
BOOKING_BOOKER_COUNTRY=us
BOOKING_CURRENCY=USD
